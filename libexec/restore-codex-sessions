#!/bin/sh

# Restore every Codex session mapped to a terminal surface in the current
# Ghostty application process. This script is started by the zsh integration
# and claims a one-shot marker so many restored shells remain safe.

set -u
umask 077

runtime_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." 2>/dev/null && pwd) || exit 0
applescript_dir=${GHOSTX_APPLESCRIPT_DIR:-"$runtime_dir/applescript"}
state_dir=${GHOSTX_STATE_DIR:-"${XDG_STATE_HOME:-$HOME/.local/state}/ghostx"}
state_file="$state_dir/state.json"
osascript_bin=${GHOSTX_OSASCRIPT:-/usr/bin/osascript}
codex_home=${CODEX_HOME:-"$HOME/.codex"}
max_restore_sessions=${GHOSTX_MAX_RESTORE_SESSIONS:-0}
case "$max_restore_sessions" in
  ''|*[!0-9]*) max_restore_sessions=0 ;;
esac

session_rollout_exists() {
  wanted_id=$1
  for rollout_path in "$codex_home"/sessions/*/*/*/*.jsonl; do
    [ -f "$rollout_path" ] || continue
    rollout_name=${rollout_path##*/}
    case "$rollout_name" in
      *-"$wanted_id".jsonl) return 0 ;;
    esac
  done
  return 1
}

ghostty_instance_id() {
  ps -axo pid=,command= 2>/dev/null |
    awk '$2 ~ /\/Ghostty\.app\/Contents\/MacOS\/ghostty$/ { print $1; exit }'
}

if [ -n "${GHOSTX_INSTANCE_ID:-}" ]; then
  instance_id=$GHOSTX_INSTANCE_ID
else
  instance_id=$(ghostty_instance_id)
fi
instance_id=$(printf '%s' "$instance_id" | tr -cd 'A-Za-z0-9_-')
[ -n "$instance_id" ] || exit 0

run_dir="$state_dir/run"
mkdir -p "$run_dir" || exit 0
done_file="$run_dir/restored-$instance_id"
lock_dir="$run_dir/restoring"
[ ! -e "$done_file" ] || exit 0
mkdir "$lock_dir" 2>/dev/null || exit 0
cleanup_lock() {
  rmdir "$lock_dir" 2>/dev/null || true
}
trap cleanup_lock EXIT HUP INT TERM

mark_done() {
  printf '%s\n' "$(date +%s):$1" >"$done_file"
}

# Claim the Ghostty process before looking for saved mappings. A fresh install
# may launch Ghostty before any Codex session has been bound. That process must
# still be marked as handled so a later ordinary tab does not look like an app
# restoration after state.json appears.
if [ ! -f "$state_file" ] ||
  ! /usr/bin/plutil -convert json -o - "$state_file" >/dev/null 2>&1 ||
  [ ! -r "$applescript_dir/restore-surface.applescript" ]; then
  mark_done 0
  exit 0
fi

# Native restoration creates surfaces asynchronously. Wait for the terminal
# count to remain stable before sending input. Tests can skip this delay.
if [ -z "${GHOSTX_SKIP_WAIT:-}" ]; then
  sleep 1
  previous_count=""
  stable_count=0
  attempts=0
  while [ "$attempts" -lt 20 ]; do
    current_count=$(
      "$osascript_bin" "$applescript_dir/count-terminals.applescript" 2>/dev/null
    ) || current_count=""
    if [ -n "$current_count" ] && [ "$current_count" = "$previous_count" ]; then
      stable_count=$((stable_count + 1))
      [ "$stable_count" -ge 3 ] && break
    else
      stable_count=0
      previous_count=$current_count
    fi
    sleep 0.25
    attempts=$((attempts + 1))
  done
fi

surface_ids=$(/usr/bin/plutil -extract surfaces raw -o - "$state_file" 2>/dev/null) || {
  mark_done 0
  exit 0
}
restored=0
candidate_file=$(mktemp "$state_dir/restore-candidates.XXXXXX") || {
  mark_done 0
  exit 0
}
cleanup_candidates() {
  rm -f "$candidate_file" 2>/dev/null || true
}
cleanup_all() {
  cleanup_candidates
  cleanup_lock
}
trap cleanup_all EXIT HUP INT TERM

for surface_id in $surface_ids; do
  session_id=$(
    /usr/bin/plutil -extract "surfaces.$surface_id.session_id" raw -o - "$state_file" 2>/dev/null
  ) || continue
  agent=$(
    /usr/bin/plutil -extract "surfaces.$surface_id.agent" raw -o - "$state_file" 2>/dev/null
  ) || continue
  [ "$agent" = "codex" ] || continue
  case "$session_id" in
    ????????-????-????-????-????????????) ;;
    *) continue ;;
  esac
  session_rollout_exists "$session_id" || continue
  updated_at=$(
    /usr/bin/plutil -extract "surfaces.$surface_id.updated_at" raw -o - "$state_file" 2>/dev/null
  ) || updated_at=0
  case "$updated_at" in
    ''|*[!0-9]*) updated_at=0 ;;
  esac
  printf '%s\t%s\n' "$updated_at" "$surface_id" >>"$candidate_file"
done

if [ "$max_restore_sessions" -eq 0 ]; then
  selected_candidates=$(sort -rn "$candidate_file")
else
  selected_candidates=$(sort -rn "$candidate_file" | head -n "$max_restore_sessions")
fi

while IFS='	' read -r updated_at surface_id; do
  [ -n "$surface_id" ] || continue
  session_id=$(
    /usr/bin/plutil -extract "surfaces.$surface_id.session_id" raw -o - "$state_file" 2>/dev/null
  ) || continue

  # An interactive update prompt exits before Codex processes the resume
  # request. Suppress that prompt only for automatic restoration; ordinary
  # Codex launches still check for updates normally.
  resume_command="export GHOSTX_SURFACE_ID='$surface_id'; codex -c check_for_update_on_startup=false resume '$session_id'"
  result=$(
    "$osascript_bin" "$applescript_dir/restore-surface.applescript" \
      "$surface_id" "$resume_command" 2>/dev/null
  ) || result=""
  [ "$result" = "restored" ] && restored=$((restored + 1))
done <<EOF
$selected_candidates
EOF

mark_done "$restored"
exit 0
